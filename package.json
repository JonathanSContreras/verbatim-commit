{
  "name": "verbatim-commit",
  "version": "0.1.0",
  "description": "Local-first AI commit message generator + low-effort commit verifier",
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "git-hooks",
    "commit-msg",
    "conventional-commits",
    "ollama",
    "local-llm",
    "ai",
    "cli"
  ],
  "author": "Jonathan Contreras (https://github.com/JonathanSContreras)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSContreras/verbatim-commit.git"
  },
  "homepage": "https://github.com/JonathanSContreras/verbatim-commit#readme",
  "bugs": {
    "url": "https://github.com/JonathanSContreras/verbatim-commit/issues"
  },
  "type": "module",
  "bin": {
    "verbatim": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
